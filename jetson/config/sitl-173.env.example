# SITL profile for Darren's Windows PC (DESKTOP-BGT94JT.local).
# Copy to ~/.config/ros_px4/sitl-173.env on the Jetson.
#
# The PC must expose its Ubuntu/WSL SSH server to the Jetson, accept key-based
# login, and have PX4-Autopilot and Gazebo installed in Ubuntu.
# Add the pc-173-sitl SSH alias shown in jetson/README.md.

SITL_HOST="pc-173-sitl"
SITL_REMOTE_PX4_DIR="~/PX4-Autopilot"

# Jetson IP as seen by the PC; PX4's DDS client connects here on UDP 8888.
SITL_AGENT_IP="192.168.0.170"

SITL_MODE="remote"
SITL_GUI="true"
LOGBOOK_RATE_HZ="100"
EXECUTOR_RATE_HZ="50.0"
